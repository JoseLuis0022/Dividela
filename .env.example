# --- Puertos publicados en el host ---
FRONTEND_PORT=5173
BACKEND_PORT=8000

# --- URLs base (clave para desplegar detrás de un Cloudflare Tunnel) ---
# FRONTEND_BASE_URL: la usa el backend para armar el link que se codifica en
# el QR (FRONTEND_BASE_URL + /join/{id}). En local puede quedarse así; al
# desplegar, cámbiala por el subdominio público del frontend, ej.
# https://cuenta.tudominio.com
FRONTEND_BASE_URL=http://localhost:5173

# BACKEND_BASE_URL: se pasa como build-arg al frontend (VITE_API_BASE_URL)
# para que sepa a qué backend llamar. Déjala vacía en local/LAN (el frontend
# infiere el backend automáticamente a partir del hostname + BACKEND_PORT).
# Al desplegar con Cloudflare Tunnel, fija el subdominio público del backend,
# ej. https://api-cuenta.tudominio.com
BACKEND_BASE_URL=

# --- Modelo de visión para leer los tickets (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
